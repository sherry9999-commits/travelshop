# ---------------------------------------------------------------------------
.vite/
.cache/
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache
coverage/
*.tsbuildinfo
tmp/
.tmp/
temp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
